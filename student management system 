#include <iostream>
#include <fstream>
#include <string>
using namespace std;

struct Student
{
    int id;
    string name;
};

void addStudent()
{
    Student s;
    cout << "Enter ID: ";
    cin >> s.id;

    cin.ignore();
    cout << "Enter Name: ";
    getline(cin, s.name);

    ofstream file("students.txt", ios::app);
    file << s.id << " " << s.name << endl;
    file.close();

    cout << "Student Added Successfully\n";
}

void displayStudents()
{
    ifstream file("students.txt");

    int id;
    string name;

    cout << "\nStudent Records:\n";

    while(file >> id)
    {
        file.ignore();
        getline(file, name);
        cout << "ID: " << id << " Name:" << name << endl;
    }

    file.close();
}

int main()
{
    int choice;

    do
    {
        cout << "\n1.Add Student\n";
        cout << "2.Display Students\n";
        cout << "3.Exit\n";

        cout << "Enter Choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                addStudent();
                break;

            case 2:
                displayStudents();
                break;

            case 3:
                cout << "Exit";
                break;

            default:
                cout << "Invalid Choice";
        }

    }while(choice != 3);

    return 0;
}