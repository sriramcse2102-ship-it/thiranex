#include <iostream>
using namespace std;

char board[3][3] = {
    {'1','2','3'},
    {'4','5','6'},
    {'7','8','9'}
};

void displayBoard() {
    cout << "\n";
    for(int i=0;i<3;i++) {
        for(int j=0;j<3;j++) {
            cout << board[i][j] << " ";
        }
        cout << endl;
    }
}

int checkWin() {
    for(int i=0;i<3;i++) {
        if(board[i][0]==board[i][1] && board[i][1]==board[i][2])
            return 1;

        if(board[0][i]==board[1][i] && board[1][i]==board[2][i])
            return 1;
    }

    if(board[0][0]==board[1][1] && board[1][1]==board[2][2])
        return 1;

    if(board[0][2]==board[1][1] && board[1][1]==board[2][0])
        return 1;

    return 0;
}

void markBoard(int pos, char player) {
    int row=(pos-1)/3;
    int col=(pos-1)%3;

    if(board[row][col]!='X' && board[row][col]!='O')
        board[row][col]=player;
}

int main() {
    int move;
    char player='X';

    for(int turn=0; turn<9; turn++) {
        displayBoard();

        cout << "\nPlayer " << player << " Enter Position: ";
        cin >> move;

        markBoard(move, player);

        if(checkWin()) {
            displayBoard();
            cout << "\nPlayer " << player << " Wins!";
            return 0;
        }

        player = (player=='X') ? 'O' : 'X';
    }

    displayBoard();
    cout << "\nMatch Draw!";
    return 0;
}